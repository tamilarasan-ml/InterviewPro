  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",

  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",

    "lint": "eslint src --ext .ts",

    "test": "echo \"No tests configured\"",

    "clean": "rimraf dist",

    "type-check": "tsc --noEmit"
  },

  "keywords": [
    "interview",
    "ai",
    "azure-openai",
    "express",
    "typescript",
    "resume",
    "mock-interview"
  ],

  "dependencies": {
    "@azure/ai-projects": "^2.4.0",
    "@azure/identity": "^4.13.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "zod": "^4.4.3"
  },

  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0"
  }
